<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>exchange.core2</groupId>
        <artifactId>collections-parent</artifactId>
        <version>0.7.0-SNAPSHOT</version>
    </parent>

    <artifactId>collections-core</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>High performance primitive Java collections - no runtime dependencies</description>

    <properties>
        <maven.compiler.release>${published.compiler.release}</maven.compiler.release>
    </properties>

    <!--
        DELIBERATELY EMPTY at compile scope.
        This artifact must stay dependency-free: the agrona helpers it used (Hashing.hash,
        BitUtil.findNextPositivePowerOfTwo, LongLongConsumer) are inlined, and there is no logging.
    -->
    <dependencies>
        <dependency>
            <groupId>org.agrona</groupId>
            <artifactId>agrona</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.pholser</groupId>
            <artifactId>junit-quickcheck-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.pholser</groupId>
            <artifactId>junit-quickcheck-generators</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven.jar.plugin.version}</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <!-- a stable module name on the module path (no module-info yet) -->
                            <Automatic-Module-Name>exchange.core2.collections</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- the hashtable tests once more with a non-zero hash seed: a static final, read once per
                             JVM - this execution gets a JVM of its own -->
                        <id>hashtable-seed</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/hashtable/*Test.java</include>
                            </includes>
                            <systemPropertyVariables>
                                <exchange.hashtable.seed>0x9e3779b97f4a7c15</exchange.hashtable.seed>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
